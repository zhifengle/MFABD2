{
    "Collect_Loc_OutToSwip_Hub_Egress": {
        "desc": "[Unity Bridge] 三类卡带均可由快捷键直达；到达可视页尾即走原有类别完成出口，不执行幅度不稳定的横向大滑动。",
        "next": [
            "[Anchor]SmartSwipOut",
            "Global_Null"
        ]
    },
    "Collect_StoryPack_IsActive": {
        "desc": "[Unity Bridge] 仅剧情页签可通过。剧情色核把 NonStoryPackActive 清零；角色/活动色核将其置为非零。",
        "recognition": "Custom",
        "custom_recognition": "CheckTag",
        "custom_recognition_param": {
            "tag": "NonStoryPackActive",
            "max": 1
        }
    },
    "Collect_Loc_ClearNonStoryTag": {
        "action": "Custom",
        "custom_action": "ResetTag",
        "custom_action_param": {
            "tags": [
                "NonStoryPackActive"
            ]
        },
        "next": [
            "Collect_FirstBootPack"
        ]
    },
    "Collect_Loc_SetNonStoryTag": {
        "action": "Custom",
        "custom_action": "UpdateTag",
        "custom_action_param": {
            "tag": "NonStoryPackActive",
            "value": 1
        },
        "next": [
            "Collect_FirstBootPack"
        ]
    },
