{
    "Collect_Story14_Init": {
        "desc": "剧情14进入后安装完成标记，并临时放宽返回探索告示板按钮阈值；横幅遮挡导致仍未命中时只在本剧情内等待重试。",
        "recognition": "Or",
        "any_of": ["Rec_SandBox_Pin_Tpl", "Rec_SandBox_Run_Tpl"],
        "action": "Custom",
        "custom_action": "PatchPipeline",
        "custom_action_param": {
            "patches": {
                "Collect_IM_Closure": {
                    "action": "Custom",
                    "custom_action": "MarkComplete",
                    "custom_action_param": {
                        "card_name": "Story_14_神圣审判",
                        "cycle_type": "g_weekly"
                    }
                },
                "Collect_ReturnToExplorationBoard_Open": {
                    "threshold": 0.6,
                    "on_error": [
                        "Collect_Story14_ReturnBoard_Open_Wait",
                        "Collect_Story14_ReturnBoard_Failed"
                    ]
                }
            }
        },
        "anchor": {
            "ExplorationBoard_Arrived": "Collect_Story14_Board_Arrived",
            "IM_Reset_Next": "Collect_Story14_AfterReset"
        },
        "next": ["Collect_ReturnToExplorationBoard"],
        "focus": "C14.先回到探索告示板"
    },
    "Collect_Story14_ReturnBoard_Open_Wait": {
        "desc": "剧情14专用：寻路按钮被横幅遮挡时等待一秒再重试；不修改 upstream 通用节点的静态定义。",
        "max_hit": 15,
        "recognition": "DirectHit",
        "action": "DoNothing",
        "post_delay": 1000,
        "next": ["Collect_ReturnToExplorationBoard_Open"],
        "on_error": ["Collect_Story14_ReturnBoard_Failed"],
        "focus": "C14.[WRN]寻路按钮被遮挡，等待后重试"
    },
    "Collect_Story14_ReturnBoard_Failed": {
        "desc": "剧情14专用：返回探索告示板重试耗尽，先还原运行时补丁。",
        "recognition": "DirectHit",
        "action": "Custom",
        "custom_action": "RestorePipeline",
        "custom_action_param": {
            "target": [
                "Collect_IM_Closure",
                "Collect_ReturnToExplorationBoard_Open"
            ]
        },
        "anchor": {
            "ExplorationBoard_Arrived": "",
            "OnFoot_Skill": "",
            "IM_Reset_Next": ""
        },
        "next": ["Collect_Story14_ReturnBoard_Failed_Stop"],
        "focus": "C14.[ERR]返回探索告示板失败，清理环境"
    },
    "Collect_Story14_ReturnBoard_Failed_Stop": {
        "desc": "剧情14无法返回探索告示板，停止当前地图采集任务。",
        "recognition": "DirectHit",
        "action": "StopTask",
        "focus": "C14.[ERR]返回探索告示板重试耗尽"
    },
    "Collect_Story14_Board_Arrived": {
        "desc": "抵达探索告示板，以此为稳定起点完成第一段采集。",
        "recognition": "Or",
        "any_of": ["Rec_SandBox_Pin_Tpl", "Rec_SandBox_Run_Tpl"],
        "anchor": {
            "OnFoot_Skill": "Collect_Story14_OpenNviMap_Left"
        },
        "next": ["Collect_Skill_Start"],
        "focus": "C14.采集探索告示板所在区域"
    },
    "Collect_Story14_OpenNviMap_Left": {
        "desc": "安全区采集结束后展开导航地图。",
        "max_hit": 3,
        "recognition": "Or",
        "any_of": ["Rec_SandBox_Pin_Tpl", "Rec_SandBox_Run_Tpl"],
        "action": "Click",
        "target": [132, 103, 10, 10],
        "pre_delay": 2000,
        "post_delay": 2500,
        "next": ["Collect_Story14_Left_Move"],
        "on_error": [
            "Collect_Story14_OpenNviMap_Left",
            "Global_Null_Exception"
        ],
        "focus": "C14.展开导航地图前往左侧回廊"
    },
    "Collect_Story14_Left_Move": {
        "desc": "点击导航地图左边的剑之神殿左侧回廊。",
        "max_hit": 2,
        "recognition": "And",
        "all_of": ["Collect_TeleporCircle_OnFoot_NviMap"],
        "action": "Click",
        "target": [334, 213, 10, 10],
        "post_delay": 1000,
        "next": [
            "[JumpBack]Collect_IM_Move_MGS",
            "[JumpBack]Collect_IM_OnFoot_Moveing",
            "[JumpBack]Global_WaitingForLoading",
            "Collect_Story14_Left_Arrived"
        ],
        "on_error": [
            "Collect_Story14_Left_Move",
            "Global_Null_Exception"
        ],
        "focus": "C14.步行前往剑之神殿左侧回廊"
    },
    "Collect_Story14_Left_Arrived": {
        "desc": "抵达左侧回廊，采集后先返回探索告示板。",
        "recognition": "Or",
        "any_of": ["Rec_SandBox_Pin_Tpl", "Rec_SandBox_Run_Tpl"],
        "anchor": {
            "OnFoot_Skill": "Collect_Story14_ReturnBoard_AfterLeft"
        },
        "next": ["Collect_Skill_Start"],
        "focus": "C14.采集剑之神殿左侧回廊"
    },
    "Collect_Story14_ReturnBoard_AfterLeft": {
        "desc": "左侧回廊采集结束，返回探索告示板后再前往中央回廊。",
        "recognition": "Or",
        "any_of": ["Rec_SandBox_Pin_Tpl", "Rec_SandBox_Run_Tpl"],
        "anchor": {
            "ExplorationBoard_Arrived": "Collect_Story14_OpenNviMap_Central"
        },
        "next": ["Collect_ReturnToExplorationBoard"],
        "focus": "C14.返回探索告示板重置中央回廊起点"
    },
    "Collect_Story14_OpenNviMap_Central": {
        "desc": "回到探索告示板后展开导航地图。",
        "max_hit": 3,
        "recognition": "Or",
        "any_of": ["Rec_SandBox_Pin_Tpl", "Rec_SandBox_Run_Tpl"],
        "action": "Click",
        "target": [132, 103, 10, 10],
        "pre_delay": 2000,
        "post_delay": 2500,
        "next": ["Collect_Story14_Central_Move"],
        "on_error": [
            "Collect_Story14_OpenNviMap_Central",
            "Global_Null_Exception"
        ],
        "focus": "C14.展开导航地图前往中央回廊"
    },
    "Collect_Story14_Central_Move": {
        "desc": "点击导航地图右边的剑之神殿中央回廊；该区域没有传送阵。",
        "max_hit": 2,
        "recognition": "And",
        "all_of": ["Collect_TeleporCircle_OnFoot_NviMap"],
        "action": "Click",
        "target": [485, 233, 10, 10],
        "post_delay": 1000,
        "next": [
            "[JumpBack]Collect_IM_Move_MGS",
            "[JumpBack]Collect_IM_OnFoot_Moveing",
            "[JumpBack]Global_WaitingForLoading",
            "Collect_Story14_Central_Arrived"
        ],
        "on_error": [
            "Collect_Story14_Central_Move",
            "Global_Null_Exception"
        ],
        "focus": "C14.步行前往剑之神殿中央回廊"
    },
    "Collect_Story14_Central_Arrived": {
        "desc": "抵达中央回廊，完成最后一次采集后结束剧情14。",
        "recognition": "Or",
        "any_of": ["Rec_SandBox_Pin_Tpl", "Rec_SandBox_Run_Tpl"],
        "anchor": {
            "OnFoot_Skill": "Collect_IM_Closure"
        },
        "next": ["Collect_Skill_Start"],
        "focus": "C14.采集剑之神殿中央回廊"
    },
    "Collect_Story14_AfterReset": {
        "desc": "剧情14收尾：完成标记与通用步行环境已还原；此处还原剧情14对寻路按钮的临时覆盖，再调出快速卡带菜单继续后续卡带。",
        "recognition": "Or",
        "any_of": [
            "Global_QuickCart_MenuReset_Ocr",
            "Rec_SandBox_Pin_Tpl",
            "Rec_SandBox_Run_Tpl"
        ],
        "anchor": {
            "IM_Reset_Next": ""
        },
        "action": "Custom",
        "custom_action": "RestorePipeline",
        "custom_action_param": {
            "target": ["Collect_ReturnToExplorationBoard_Open"]
        },
        "next": ["Global_QuickCart_MenuReset"],
        "focus": "C14.回到快速卡带菜单"
    }
}
