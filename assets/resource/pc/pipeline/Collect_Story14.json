        "custom_action_param": {
            "target": "Collect_IM_Closure",
            "patch": {
                "action": "Custom",
                "custom_action": "MarkComplete",
                "custom_action_param": {
                    "card_name": "Story_14_神圣审判",
                    "cycle_type": "g_weekly"
